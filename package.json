{
  "name": "wiz-factory-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "SYNTHETIC demo. Self-hosted Wiz to Jira to Cursor cloud-agent orchestrator using @cursor/sdk.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "wiz-factory": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js serve",
    "scenario:jwt": "tsx src/cli.ts run-scenario jwt --dry-run",
    "reset:jira": "tsx src/cli.ts reset"
  },
  "dependencies": {
    "@cursor/sdk": "1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
