# SYNTHETIC demo placeholders. Do not put real tokens in git.
# Jira site for the sandbox project. Basic auth is email + API token.
JIRA_BASE_URL=https://fe-anysphere-demo.atlassian.net
JIRA_EMAIL=demo-user@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
JIRA_PROJECT_KEY=JWF

# Shared secret for POST /intake and POST /remediate (header X-Webhook-Secret).
WEBHOOK_SECRET=replace-with-shared-secret

# Cursor user or service-account API key. Team Admin keys are not accepted by the SDK.
CURSOR_API_KEY=cursor_replace-me
# Optional. Cloud runs use the account default when this is unset.
CURSOR_MODEL=composer-2.5
CURSOR_STARTING_REF=main

# Wiz names acme-demo/<repo> are rewritten to this GitHub owner.
GITHUB_OWNER=calwatson

PORT=8787
# AGENT_POLL_INTERVAL_MS=5000
# AGENT_POLL_MAX_MS=3600000
# CURSOR_SKIP_REVIEWER_REQUEST=true
# JIRA_PARENT_ISSUE_TYPE=Epic
# Optional custom-field id overrides (customfield_12345) if name lookup is not enough:
# JIRA_FIELD_DEDUP_KEY=
# JIRA_FIELD_FIX_LOCATION=
# JIRA_FIELD_CORRELATION_GROUP=
# JIRA_FIELD_CROSS_REPO_KEY=
# JIRA_FIELD_RISK_SCORE=
# JIRA_FIELD_AGENT_LANE=
# JIRA_FIELD_PR_URL=
